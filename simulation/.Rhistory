library(hdm); library(hqreg); library(quantreg); library(doSNOW)
data <- pension
alpha <- matrix(data$p401); z <- matrix(data$e401); y <- matrix(data$tw)
# minimal control set just for timing
control <- as.matrix(cbind(data$i2,data$i3,data$i4,data$i5,data$i6,data$i7,
data$a1,data$a2,data$a3,data$a4,data$marr,data$fsize))
ptm <- proc.time()
test <- gmm_parallel(y, alpha, control, z, 0.5, seq(0,35000,100), 8)
print(proc.time() - ptm)
